@page "/register"
@inject AuthService authService
@inject NavigationManager navigation

<h3>S'inscrire</h3>

<EditForm Model="@form" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="Username">Nom d'utilisateur :</label>
        <InputText id="Username" @bind-Value="form.Username" class="form-control" />
        <ValidationMessage For="() => form.Username" />
    </div>

    <div class="form-group">
        <label for="Email">Email :</label>
        <InputText id="Email" @bind-Value="form.Email" class="form-control" />
        <ValidationMessage For="() => form.Email" />
    </div>

    <div class="form-group">
        <label for="Password">Mot de passe :</label>
        <InputText id="Password" type="password" @bind-Value="form.Password" class="form-control" />
        <ValidationMessage For="() => form.Password" />
    </div>

    <div class="form-group">
        <label for="ConfirmPassword">Confirmer le mot de passe :</label>
        <InputText id="ConfirmPassword" type="password" @bind-Value="form.ConfirmPassword" class="form-control" />
        <ValidationMessage For="() => form.ConfirmPassword" />
    </div>

    <button type="submit" class="btn btn-primary">S'inscrire</button>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-2">@errorMessage</div>
    }
</EditForm>

@code {
    private RegisterUserForm form = new RegisterUserForm();
    private string? errorMessage;

    private async Task OnSubmit()
    {
        var result = await authService.ExecuteAsync(new RegisterUserCommand(form.Username, form.Email, form.Password));

        if (result.IsSuccess)
        {
            navigation.NavigateTo("/login", true);
        }
        else
        {
            errorMessage = "Une erreur est survenue lors de l'inscription.";
        }
    }
}
