@page "/posts"
@inject NavigationManager Navigation
@inject ILogger<Posts> Logger
@inject IPostRepository PostRepository
@inject IAuthRepository AuthRepository
@inject ILikeRepository LikeRepository
@inject IPostViewRepository PostViewRepository

<h3>Titres des posts</h3>

<a href="/posts/create" class="btn btn-primary btn-sm active">Nouveau Post</a>

@if (_postTitles is not null)
{
    <table class="table">
        <thead class="thead-dark">
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Titre</th>
            <th scope="col">Auteur</th>
            <th scope="col">Créé il y a</th>
            <th scope="col">Vues</th>
            <th scope="col">J'aime</th>
            <th scope="col">Réponses</th>
            <th scope="col">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var postTitle in _postTitles)
        {
            <tr>
                <th scope="row">@postTitle.PostId</th>
                <td>@postTitle.Title</td>
                <td>@postTitle.Author</td>
                <td>@GetTimeElapsed(postTitle.CreatedAt)</td>
                <td>@postTitle.ViewCount</td>
                <td>
                    <button class="btn btn-sm @(postTitle.IsLiked ? "btn-success" : "btn-outline-secondary")"
                            @onclick='() => HandleLike(postTitle)'>
                        👍 @postTitle.LikeCount
                    </button>
                </td>
                <td>@postTitle.ReplyCount</td>
                <td>
                    <a href="#" @onclick="() => HandlePostClick(postTitle.PostId)" class="btn btn-primary btn-sm active">
                        Détails
                    </a> |
                    <a @onclick="() => OnDelete(postTitle)" class="btn btn-danger btn-sm active">Supprimer</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<PostTitle?>? _postTitles;
    private int? _userId;

    protected override async Task OnInitializedAsync()
    {
        var (userId, _) = await AuthRepository.GetUser();
        _userId = userId;

        if (_userId.HasValue)
        {
            var queryResult = await PostRepository.ExecuteAsync(new ListeTitlePostsQuery(_userId.Value));

            if (queryResult.IsFailure)
            {
                Logger.LogError($"Erreur : {queryResult.ErrorMessage}");
                return;
            }

            _postTitles = queryResult.Content.ToList();
        }
    }

    private async Task HandlePostClick(int postId)
    {
        if (_userId.HasValue)
        {
            var result = await PostViewRepository.ExecuteAsync(new IncrementPostViewsCommand(postId, _userId.Value));

            if (result.IsFailure)
            {
                Logger.LogError($"Erreur lors de l'incrémentation des vues : {result.Exception}, {result.ErrorMessage}");
            }
        }

        Navigation.NavigateTo($"/posts/detail/{postId}");
    }
    
    public async Task OnDelete(PostTitle post)
    {
        _postTitles!.Remove(post);

        Result result = await PostRepository.ExecuteAsync(new DeletePostCommand(post.PostId));

        if (result.IsFailure)
            Logger.LogError($"Error : {result.Exception}, {result.ErrorMessage}");
    }

    private async Task HandleLike(PostTitle post)
    {
        if (_userId.HasValue)
        {
            var command = new LikeCommand(_userId.Value, post.PostId, "Post");
            var result = await LikeRepository.ExecuteAsync(command);
            if (result.IsSuccess)
            {
                post.IsLiked = !post.IsLiked;
                post.LikeCount += post.IsLiked ? 1 : -1;
            }
            else
            {
                Logger.LogError($"Error : {result.Exception}, {result.ErrorMessage}");
            }
        }
    }

    private string GetTimeElapsed(DateTime createdAt)
    {
        var localCreatedAt = createdAt.ToLocalTime();
        var elapsed = DateTime.Now - localCreatedAt;

        if (elapsed.TotalSeconds < 60)
            return "à l'instant";
        if (elapsed.TotalMinutes < 60)
            return $"Il y a {elapsed.Minutes} minute{(elapsed.Minutes > 1 ? "s" : "")}";
        if (elapsed.TotalHours < 24)
            return $"Il y a {elapsed.Hours} heure{(elapsed.Hours > 1 ? "s" : "")}";
        if (elapsed.TotalDays < 7)
            return $"Il y a {elapsed.Days} jour{(elapsed.Days > 1 ? "s" : "")}";

        return localCreatedAt.ToString("dd/MM/yyyy HH:mm");
    }
}
