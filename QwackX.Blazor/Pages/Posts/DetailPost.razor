@page "/posts/detail/{PostId:int}"
@inject ILogger<DetailPost> Logger
@inject IPostRepository PostRepository
@inject IAuthRepository AuthRepository
@inject IReplyRepository ReplyRepository
@inject ILikeRepository LikeRepository

<a href="/posts" class="btn btn-primary btn-sm active">← Retour à la liste</a>

@if (_state is States.Loading)
{
    <h3>Chargement...</h3>
}
else if (_post is null)
{
    <h3>Il semble que le post soit introuvable, veuillez retourner à la liste et réessayer...</h3>
}
else
{
    <div class="post-card">
        <div class="post-header">
            <div class="avatar">@_post.Author[0]</div>
            <div class="post-meta">
                <strong>@_post.Author</strong> · Posté dans <span class="category">Catégorie</span>
                <br />
                <span class="post-date">@_post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>

        <div class="post-content">
            <h2 class="post-title">@_post.Title</h2>
            <p class="post-description">@_post.Description</p>
        </div>

        <div class="post-footer">
            <button class="icon like-icon @( _post.IsLiked ? "liked" : "" )" @onclick='() => HandleLike(_post.PostId, "Post")'>
                👍 @_post.LikeCount
            </button>
            <span class="icon view-icon">👁️ 1269</span>
            <span class="icon comment-icon">💬 @_replies.Count()</span>
            <span class="icon time-icon">⏳ Il y a 11 heures</span>
        </div>
    </div>

    <div class="replies-section">
        <h3>Réponses</h3>
        @if (_replies.Any())
        {
            @foreach (var reply in _replies)
            {
                <div class="post-card reply-card">
                    <div class="post-header">
                        <div class="avatar">@reply.Author[0]</div>
                        <div class="post-meta">
                            <strong>@reply.Author</strong>
                            <br />
                            <span class="post-date">@reply.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>

                    <div class="post-content">
                        <p>@reply.Content</p>
                    </div>

                    <div class="post-footer">
                        <button class="icon like-icon @( reply.IsLiked ? "liked" : "" )" @onclick='() => HandleLike(reply.ReplyId, "Reply")'>
                            👍 @reply.LikeCount
                        </button>
                        <span class="icon time-icon">⏳ Il y a 11 heures</span>
                    </div>
                </div>
            }
        }
        else
        {
            <p>Aucune réponse pour l’instant.</p>
        }
    </div>
}

@code {
    [Parameter]
    public int PostId { get; set; }

    private int? _userId = null;
    private Post? _post;
    private IEnumerable<Reply?> _replies = [];
    private States _state = States.Loading;

    protected override async Task OnInitializedAsync()
    {
        var (userId, _) = await AuthRepository.GetUser();
        _userId = userId;

        if (_userId.HasValue)
        {
            var postResult = await PostRepository.ExecuteAsync(new DetailPostQuery(PostId, _userId.Value));
            if (postResult.IsSuccess)
            {
                _post = postResult.Content;

                var repliesResult = await ReplyRepository.ExecuteAsync(new ListPostRepliesQuery(PostId, _userId.Value));
                if (repliesResult.IsSuccess)
                {
                    _replies = repliesResult.Content ?? [];
                }
                else
                {
                    Logger.LogError($"Error : {repliesResult.Exception}, {repliesResult.ErrorMessage}");
                }
            }
            else
            {
                Logger.LogError($"Error : {postResult.Exception}, {postResult.ErrorMessage}");
            }
        }

        _state = States.Completed;
    }

    private async Task HandleLike(int entityId, string entityType)
    {
        if (_userId.HasValue)
        {
            var command = new LikeCommand(_userId.Value, entityId, entityType);
            var result = await LikeRepository.ExecuteAsync(command);
            if (result.IsSuccess)
            {
                if (entityType == "Post" && _post != null)
                {
                    _post.IsLiked = !_post.IsLiked;
                    _post.LikeCount += _post.IsLiked ? 1 : -1;
                }
                else
                {
                    var reply = _replies.FirstOrDefault(r => r.ReplyId == entityId);
                    if (reply != null)
                    {
                        reply.IsLiked = !reply.IsLiked;
                        reply.LikeCount += reply.IsLiked ? 1 : -1;
                    }
                }
            }
            else
            {
                Logger.LogError($"Error : {result.Exception}, {result.ErrorMessage}");
            }
        }
    }
}
